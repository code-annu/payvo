{
  "name": "payvo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:contract:emit": "pnpm --filter @payvo/database contract:emit",
    "db:plan:migration": "pnpm --filter @payvo/database plan:migration",
    "db:migrate": "pnpm --filter @payvo/database db:migrate",
    "db:setup": "pnpm db:contract:emit && pnpm db:plan:migration && pnpm db:migrate",
    "build:package:database": "pnpm --filter @payvo/database build",
    "build:package:config": "pnpm --filter @payvo/config build",
    "build:package:shared": "pnpm --filter @payvo/shared build",
    "build:packages": "pnpm build:package:database && pnpm build:package:config && pnpm build:package:shared"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "supertest": "^7.3.0",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
