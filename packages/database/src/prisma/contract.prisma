// use prisma-next



model User {
  id              String    @id @default(uuid()) 
  email           String    @unique
  passwordHash    String    @map("password_hash")
  fullname        String    @map("fullname")
  companyName     String?   @map("company_name")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  deletedAt       TimestamptzString? @map("deleted_at") 
  createdAt       TimestamptzString  @default(now()) @map("created_at") 
  updatedAt      temporal.updatedAtString()  @map("updated_at") 

  sessions  Session[]
  merchants Merchant[]

  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) 
  userId    String    @map("user_id") 
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  revokedAt TimestamptzString? @map("revoked_at") 
  expiresAt TimestamptzString  @map("expires_at") 
  createdAt TimestamptzString  @default(now()) @map("created_at") 
  updatedAt temporal.updatedAtString()  @map("updated_at") 

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("sessions")
}

model Merchant {
  id        String   @id @default(uuid()) 
  userId    String   @map("user_id") 
  isActive  Boolean  @default(true) @map("is_active")
  createdAt TimestamptzString  @default(now()) @map("created_at") 
  updatedAt temporal.updatedAtString()  @map("updated_at") 

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_merchants_user_id")
  @@map("merchants")
}


enum Environment {
  TEST
  LIVE

  @@map("environment")
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED

  @@map("api_key_status")
}

model ApiKey {
  id          String      @id @default(uuid()) 
  merchantId  String      @map("merchant_id") 
  keyId       String      @unique @map("key_id")
  secretHash  String      @map("secret_hash")
  environment Environment @map("environment")
  status      ApiKeyStatus     @default(ACTIVE) @map("status")
  deactivatedAt TimestamptzString? @map("deactivated_at")
  revokedAt   TimestamptzString?   @map("revoked_at") 
  lastUsedAt  TimestamptzString?   @map("last_used_at") 
  createdAt   TimestamptzString    @default(now()) @map("created_at") 
  updatedAt   temporal.updatedAtString()    @map("updated_at") 

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId], map: "idx_api_keys_merchant_id")
  @@index([merchantId, environment],map: "idx_api_keys_merchant_id_environment")
  @@index([merchantId, environment, status],map: "idx_api_keys_merchant_id_environment_status")
  @@map("api_keys")
}
