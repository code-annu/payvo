// Prisma ORM 7 schema for Payvo's account and authentication data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserTheme {
  SYSTEM
  LIGHT
  DARK

  @@map("user_theme")
}

enum UserAddressType {
  CONTACT
  BILLING
  SHIPPING
  OTHER

  @@map("user_address_type")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  // Uniqueness is enforced case-insensitively by a lower(email) index in SQL.
  email             String    @db.VarChar(320)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(6)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile    UserProfile?
  preference UserPreference?
  addresses  UserAddress[]
  sessions   UserSession[]

  @@map("users")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId], map: "idx_sessions_user_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("user_sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "idx_refresh_tokens_session_id")
  @@map("refresh_tokens")
}

model UserProfile {
  userId            String    @id @map("user_id") @db.Uuid
  fullName          String    @map("full_name") @db.VarChar(120)
  phoneNumber       String?   @map("phone_number") @db.VarChar(20)
  phoneVerifiedAt   DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  profilePictureUrl String?   @map("profile_picture_url") @db.VarChar(2048)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserPreference {
  userId                String    @id @map("user_id") @db.Uuid
  preferredLanguageCode String    @map("preferred_language_code") @db.VarChar(10)
  preferredCurrencyCode String    @map("preferred_currency_code") @db.Char(3)
  theme                 UserTheme @default(SYSTEM)
  timezone              String    @default("UTC") @db.VarChar(64)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredLanguage SupportedLanguage @relation(fields: [preferredLanguageCode], references: [code], onDelete: Restrict)
  preferredCurrency SupportedCurrency @relation(fields: [preferredCurrencyCode], references: [code], onDelete: Restrict)

  @@index([preferredLanguageCode])
  @@index([preferredCurrencyCode])
  @@map("user_preferences")
}

model SupportedLanguage {
  code        String           @id @db.VarChar(10)
  name        String           @db.VarChar(100)
  preferences UserPreference[]

  @@map("supported_languages")
}

model SupportedCurrency {
  code      String   @id @db.Char(3)
  name      String   @db.VarChar(100)
  minorUnit Int      @map("minor_unit") @db.SmallInt
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  preferences UserPreference[]

  @@map("supported_currencies")
}

model Country {
  code      String        @id @db.Char(2)
  name      String        @db.VarChar(100)
  addresses UserAddress[]

  @@map("countries")
}

model UserAddress {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  addressType     UserAddressType @map("address_type")
  label           String?         @db.VarChar(100)
  recipientName   String?         @map("recipient_name") @db.VarChar(120)
  street1         String          @map("street_1") @db.VarChar(255)
  street2         String?         @map("street_2") @db.VarChar(255)
  city            String?         @db.VarChar(120)
  stateOrProvince String?         @map("state_or_province") @db.VarChar(120)
  postalCode      String?         @map("postal_code") @db.VarChar(32)
  countryCode     String          @map("country_code") @db.Char(2)
  isDefault       Boolean         @default(false) @map("is_default")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryCode], references: [code], onDelete: Restrict)

  @@index([userId, addressType])
  @@index([countryCode])
  // Prisma cannot represent the partial unique index for one default address
  // per user and address type. Add it in migration SQL:
  // CREATE UNIQUE INDEX user_addresses_one_default_per_type
  //   ON user_addresses (user_id, address_type) WHERE is_default = TRUE;
  @@map("user_addresses")
}
