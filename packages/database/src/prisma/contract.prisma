// use prisma-8


model User {
  id              Uuid      @id @default(uuid()) 
  email           String    @unique
  passwordHash    String    @map("password_hash")
  fullname        String    @map("fullname")
  companyName     String?   @map("company_name")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  deletedAt       TimestamptzString? @map("deleted_at") 
  createdAt       TimestamptzString  @default(now()) @map("created_at") 
  updatedAt      temporal.updatedAtString()  @map("updated_at") 

  sessions  Session[]
  merchants Merchant[]

  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

model Session {
  id        Uuid      @id @default(uuid()) 
  userId    Uuid      @map("user_id") 
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  revokedAt TimestamptzString? @map("revoked_at") 
  expiresAt TimestamptzString  @map("expires_at") 
  createdAt TimestamptzString  @default(now()) @map("created_at") 
  updatedAt temporal.updatedAtString()  @map("updated_at") 

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId], map: "idx_sessions_user_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("sessions")
}

model RefreshToken {
  id          Uuid               @id @default(uuid())
  sessionId   Uuid               @map("session_id")
  tokenHash   String             @unique @map("token_hash")
  revokedAt   TimestamptzString? @map("revoked_at")
  createdAt   TimestamptzString  @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtString() @map("updated_at")

  session   Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "idx_refresh_tokens_session_id")
  @@map("refresh_tokens")
}



model Merchant {
  id        Uuid     @id @default(uuid()) 
  mid       String   @unique @map("mid") 
  userId    Uuid     @map("user_id") 
  isActive  Boolean  @default(true) @map("is_active")
  createdAt TimestamptzString  @default(now()) @map("created_at") 
  updatedAt temporal.updatedAtString()  @map("updated_at") 

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys      ApiKey[]
  webhooks     Webhook[]
  paymentOrders PaymentOrder[]
  // transactions  Transaction[]

  @@index([userId], map: "idx_merchants_user_id")
  @@map("merchants")
}



enum ApiKeyEnvironment {
  TEST
  LIVE
}

enum ApiKeyStatus {
  ACTIVE
  GRACE_PERIOD
  REVOKED
}

model ApiKey {
  id          Uuid        @id @default(uuid()) 
  merchantId  Uuid        @map("merchant_id") 
  keyId       String      @unique @map("key_id")
  secretHash  String      @map("secret_hash")
  environment ApiKeyEnvironment @map("environment")
  status      ApiKeyStatus     @default(ACTIVE) @map("status")
  graceEndsAt TimestamptzString? @map("grace_ends_at")
  revokedAt   TimestamptzString?   @map("revoked_at") 
  lastUsedAt  TimestamptzString?   @map("last_used_at") 
  createdAt   TimestamptzString    @default(now()) @map("created_at") 
  updatedAt   temporal.updatedAtString()    @map("updated_at") 

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId], map: "idx_api_keys_merchant_id")
  @@index([merchantId, environment],map: "idx_api_keys_merchant_id_environment")
  // Partial unique index: only one ACTIVE key per merchant per environment.
  // Enforced via raw SQL migration (PSL does not support filtered unique constraints).
  // CREATE UNIQUE INDEX "uq_api_keys_active_merchant_env" ON "api_keys" ("merchant_id", "environment") WHERE status = 'ACTIVE';
  @@map("api_keys")
}

model Webhook {
  id         Uuid               @id @default(uuid())
  merchantId Uuid               @map("merchant_id")
  secretKey  String             @map("secret_key")
  url        String             @map("url")
  createdAt  TimestamptzString  @default(now()) @map("created_at")
  updatedAt  temporal.updatedAtString() @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId], map: "idx_webhooks_merchant_id")
  @@map("webhooks")
}


model PaymentOrder {
  id                 Uuid                      @id @default(uuid())
  merchantId         Uuid                      @map("merchant_id")
  merchantCustomerId Uuid                      @map("merchant_customer_id")
  merchantOrderId    Uuid                      @map("merchant_order_id")
  idempotencyKey     String                    @unique @map("idempotency_key")
  csi                String                    @unique @map("csi")
  amount             Decimal                   @map("amount")
  currency           Char(3)                   @map("currency")
  completedAt        TimestamptzString?        @map("completed_at")
  expiresAt          TimestamptzString         @map("expires_at")
  createdAt          TimestamptzString         @default(now()) @map("created_at")
  updatedAt          temporal.updatedAtString()  @map("updated_at")

  merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  paymentAttempts  PaymentAttempt[]

  @@index([merchantId], map: "idx_payment_orders_merchant_id")
  @@map("payment_orders")
}


model PaymentMethod {
  id        Uuid              @id @default(uuid())
  code      String            @unique @map("code")
  name      String            @map("name")
  createdAt TimestamptzString @default(now()) @map("created_at")
  updatedAt temporal.updatedAtString() @map("updated_at")
  iconUrl  String           @map("icon_url")

  paymentAttempts PaymentAttempt[]

  @@map("payment_methods")
}


enum PaymentAttemptStatus {
  PROCESSING
  FAILED
  SUCCEED
}

model PaymentAttempt {
  id                Uuid                  @id @default(uuid())
  paymentOrderId Uuid                  @map("payment_order_id")
  paymentMethodId   Uuid                  @map("payment_method_id")
  attemptNumber     Int                   @map("attempt_number")
  status            PaymentAttemptStatus  @default(PROCESSING) @map("status")
  failureCode       String?               @map("failure_code")
  reason            String?               @map("reason")
  createdAt         TimestamptzString     @default(now()) @map("created_at")
  updatedAt         temporal.updatedAtString() @map("updated_at")

  paymentOrder    PaymentOrder    @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod   @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  transactions Transaction[] @relation("PaymentAttemptTransactions")

  @@index([paymentOrderId], map: "idx_payment_attempts_payment_order_id")
  @@index([paymentMethodId], map: "idx_payment_attempts_payment_method_id")
  @@unique([paymentOrderId, attemptNumber])
  @@map("payment_attempts")
}



enum PaymentType {
  PAYIN
  REFUND
}

model Transaction {
  id               Uuid          @id @default(uuid())
  merchantId       Uuid          @map("merchant_id")
  paymentOrderId   Uuid          @map("payment_order_id")
  paymentAttemptId Uuid          @map("payment_attempt_id")
  paymentType      PaymentType   @map("payment_type")
  grossAmount      Decimal @map("gross_amount")
  feeAmount        Decimal @map("fee_amount")
  netAmount        Decimal @map("net_amount")
  currency         Char(3)        @map("currency")
  createdAt        TimestamptzString  @default(now()) @map("created_at")
  updatedAt        temporal.updatedAtString()  @map("updated_at")

  merchant       Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  paymentOrder   PaymentOrder   @relation("PaymentOrderTransactions", fields: [paymentOrderId], references: [id], onDelete: Cascade)
  paymentAttempt PaymentAttempt @relation("PaymentAttemptTransactions", fields: [paymentAttemptId], references: [id], onDelete: Cascade)

  @@index([merchantId], map: "idx_transactions_merchant_id")
  @@index([paymentOrderId], map: "idx_transactions_payment_order_id")
  @@index([paymentAttemptId], map: "idx_transactions_payment_attempt_id")
  @@map("transactions")
}

